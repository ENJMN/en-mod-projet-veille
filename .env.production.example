# ============================================================
# WAYS Digital Solutions — Variables d'environnement production
# Copiez ce fichier en .env.local sur le VPS et remplissez les valeurs
# NE JAMAIS committer .env.local dans git
# ============================================================

# Clé d'administration (commentaires + articles)
# Choisissez un mot de passe fort et unique
ADMIN_KEY=CHANGER_PAR_MOT_DE_PASSE_FORT

# Resend — envoi d'emails depuis le formulaire de contact
# 1. Créez un compte sur https://resend.com (gratuit jusqu'à 3000 emails/mois)
# 2. Vérifiez votre domaine ways-ci.com dans Resend
# 3. Copiez votre clé API ici
RESEND_API_KEY=re_votre_cle_ici

# Email de réception des messages du formulaire de contact
CONTACT_EMAIL=contact@ways-ci.com

# Anthropic — génération automatique d'articles de blog
# 1. Créez un compte sur https://console.anthropic.com
# 2. Créez une clé API
# 3. Rechargez du crédit (pay-as-you-go, ~0.02$ par article)
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici
