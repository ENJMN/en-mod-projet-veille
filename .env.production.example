# ============================================================
# WAYS Digital Solutions — Variables d'environnement production
# Copiez ce fichier en .env.local sur le VPS et remplissez les valeurs
# NE JAMAIS committer .env.local dans git
# ============================================================

# Clé d'administration (commentaires + articles)
# Choisissez un mot de passe fort et unique
ADMIN_KEY=CHANGER_PAR_MOT_DE_PASSE_FORT

# Resend — envoi d'emails depuis le formulaire de contact
# 1. Créez un compte sur https://resend.com (gratuit jusqu'à 3000 emails/mois)
# 2. Vérifiez votre domaine ways-ci.com dans Resend
# 3. Copiez votre clé API ici
RESEND_API_KEY=re_votre_cle_ici

# Email de réception des messages du formulaire de contact
CONTACT_EMAIL=contact@ways-ci.com

# Anthropic — génération automatique d'articles de blog (optionnel)
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# OpenAI — chatbot Axel + audit de site
# 1. Créez un compte sur https://platform.openai.com
# 2. Créez une clé API dans API Keys
# 3. Rechargez du crédit (~0.001$ par message chat)
OPENAI_API_KEY=sk-votre-cle-openai-ici

# Supabase — authentification et base de données LMS
# 1. Créez un projet sur https://supabase.com
# 2. Allez dans Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_ici
# Service role — visible dans Settings → API → service_role (NE JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_ici

# URL du site (pour les redirections auth)
NEXT_PUBLIC_SITE_URL=https://ways-ci.com

# Bunny.net Stream — hébergement vidéo
BUNNY_STREAM_API_KEY=votre_api_key_bunny
NEXT_PUBLIC_BUNNY_LIBRARY_ID=votre_library_id
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=votre-hostname.b-cdn.net
